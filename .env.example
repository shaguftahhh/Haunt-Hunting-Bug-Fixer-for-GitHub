# ---------------------------------------------------------------------------
# BugBanisher environment example.
# Copy this file to `.env` (`cp .env.example .env`) and fill in only what you
# need. Real keys must never be committed. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=8787
# Set to "production" when deploying. Cookies stay httpOnly either way.
NODE_ENV=development

# --- GitHub OAuth app (optional) --------------------------------------------
# Create one at https://github.com/settings/developers
# Callback URL: http://localhost:8787/api/auth/github/callback
# Leave blank to use a fine-grained personal access token instead (recommended:
# least privilege, limited to selected repositories).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=repo

# --- LLM provider (open-weight models by default) ---------------------------
# LLM_PROVIDER: "ollama" (local open-weight model), "openai" (any
# OpenAI-compatible endpoint), or "none" (static checks only).
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b

# Local Ollama (default). Gemma or Llama both work, e.g. llama3.2:3b.
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible endpoint (vLLM, LM Studio, OpenRouter, Groq, ...).
# Only used when LLM_PROVIDER=openai.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=
# Set to "false" for servers that reject response_format: json_object.
LLM_JSON_MODE=true

# Timeouts and scan limits (optional tuning).
LLM_TIMEOUT_MS=180000
SCAN_MAX_FILES=25
SCAN_MAX_FILE_BYTES=60000
LLM_MAX_FILES=6
LLM_MAX_FILE_CHARS=6000

# --- Safety -----------------------------------------------------------------
# PR approvals are always capped at 3 per browser session (not configurable).
# Dry-run defaults to ON and must be switched off in the UI for real writes.
